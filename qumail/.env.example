# Copy to .env and fill in real values. Never commit the real .env file.

# ETSI 014 Key Manager — defaults used until POST /auth/km reconfigures them.
KM_BASE_URL=http://127.0.0.1:8100
SAE_ID=SAE-ALICE

# Encrypted-at-rest key store (backend/app/keystore).
KEYSTORE_PATH=keystore.json
KEYSTORE_MASTER_PASSWORD=change-me

# uvicorn bind address.
HOST=127.0.0.1
PORT=8000
